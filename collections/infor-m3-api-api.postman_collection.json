  "info": {
    "_postman_id": "cc98054a-4e74-489c-925b-41abed1eebe3",
    "name": "Infor ION API Gateway ION Documents M3 API API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Infor ION API Gateway provides a managed OAuth 2.0 API layer for integrating Infor CloudSuite applications (M3, LN, Baan, SunSystems, etc.) with third-party systems. The gateway exposes REST endpoints for ION Documents, ION Events, and ION API services with support for Authorization Code, Client Credentials, and SAML Bearer grant types.\n\nContact Support:\n Name: Infor Support",
      "type": "text/plain"
    }
  }
