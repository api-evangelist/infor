        {
          "id": "758351c6-269d-4337-bcda-e87b45881336",
          "name": "Call M3 MI program (GET)",
          "request": {
            "name": "Call M3 MI program (GET)",
            "description": {
              "content": "Executes an Infor M3 MI (Management Interface) program transaction via the ION API Gateway. GET requests retrieve data from M3. The programId follows the pattern {ProgramName}/{TransactionName} (e.g., CRS610MI/GetBasicData).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                ":apiVersion",
                ":programId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "CUNO",
                  "value": "<string>",
                  "description": "Customer number (example M3 input field)"
                },
                {
                  "disabled": false,
                  "key": "maxrecs",
                  "value": "10",
                  "description": "Maximum records to return"
                },
                {
                  "disabled": false,
                  "key": "returncols",
                  "value": "<string>",
                  "description": "Comma-separated column names to return"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "latest",
                  "key": "apiVersion",
                  "description": "(Required) API version (e.g., \"latest\" or specific version number)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "programId",
                  "description": "(Required) M3 MI program and transaction (e.g., \"CRS610MI/GetBasicData\")"
                },
                {
                  "description": "ION API gateway hostname",
                  "type": "any",
                  "value": "{{os}}",
                  "key": "os"
                },
                {
                  "description": "Tenant ID",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                },
                {
                  "description": "Infor product code",
                  "type": "any",
                  "value": "{{product}}",
                  "key": "product"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
